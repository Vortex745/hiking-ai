# ==================== LLM 配置 ====================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-llm-api-key
OPENAI_MODEL=deepseek-v4-flash

# ==================== Embedding 配置 ====================
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ==================== Rerank 配置（可选） ====================
RERANK_BASE_URL=https://api.openai.com/v1
RERANK_API_KEY=your-rerank-api-key
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_ENABLED=true

# ==================== 数据库配置 ====================
POSTGRES_DB=ai_hiking
POSTGRES_USER=ai_hiking
POSTGRES_PASSWORD=ai_hiking
# 可选：使用 Neon 等外部 Postgres 时填写完整连接串，会覆盖上面的本地 Compose 数据库
DATABASE_URL=
# 可选：Vercel/Neon serverless 冷启动时可适当调大
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# ==================== 内存配置 ====================
MEMORY_ENABLED=true
# 可选：Vercel Marketplace Redis/Upstash 可注入 REDIS_URL、KV_URL 或 UPSTASH_REDIS_URL
REDIS_URL=
# 可选：如果 Marketplace 只注入 REST 变量，AI Service 会通过 Upstash REST API 存取聊天历史
KV_URL=
UPSTASH_REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==================== 高德地图 API（可选） ====================
AMAP_API_KEY=

# ==================== 云知识库 API（可选） ====================
RAG_DOCS_API_URL=

# ==================== 服务端口 ====================
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
